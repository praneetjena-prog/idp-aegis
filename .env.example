# ==============================================================================
# AEGIS OPEN BMS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local or .env to activate live Google OAuth & Supabase backend.
# If these variables are omitted, Aegis runs in local demonstration & sandbox mode.

# Supabase API Configuration (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Google Cloud OAuth 2.0 Client ID (From Google Cloud Console -> APIs & Services -> Credentials)
# Authorized JavaScript Origins: http://localhost:5173, https://your-domain.com
# Authorized Redirect URI: https://your-project.supabase.co/auth/v1/callback
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Aegis Demonstration Telemetry Mode ('live' | 'fault' | 'nominal')
VITE_DEFAULT_FEED_MODE=fault
